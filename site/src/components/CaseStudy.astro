---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import FeatureStage from "./FeatureStage.astro";
import WorkVideo from "./WorkVideo.astro";
import { workBadge } from "../lib/site";
import { renderProse } from "../lib/prose";

interface Props {
  entry: CollectionEntry<"work">;
  next?: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const d = entry.data;
const badge = workBadge(d);
const nextBadge = next ? workBadge(next.data) : undefined;
const confirmed = d.metrics.filter((m) => m.confirmed);
const quotes = d.researchQuotes ?? [];
const v = d.visuals;
const gallery = d.gallery ?? {};
const clips = d.clips ?? [];
const heroMetrics = entry.id === "field-dispatch" && confirmed.length > 0;

function html(s?: string) {
  return s ? renderProse(s) : "";
}

function initials(name: string) {
  return name
    .split(/\s+/)
    .map((part) => part.replace(/[^A-Za-z]/g, "")[0])
    .filter(Boolean)
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---

<article>
  <header class="cs-header wrap">
    <p class="cs-kicker">
      {badge ? <span class="badge">{badge}</span> : null}
      Case study
    </p>
    <h1>{d.title}</h1>
    <p class="cs-sub">{d.subtitle}</p>
    {
      d.recreatedNote ? (
        <p class="note">{d.recreatedNote}</p>
      ) : null
    }
    {
      d.company || d.role || d.years || d.status || d.platforms || d.tools ? (
        <dl class="meta-row">
          {d.company ? (
            <div>
              <dt>Company</dt>
              <dd>{d.company}</dd>
            </div>
          ) : null}
          {d.role ? (
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
          ) : null}
          {d.years ? (
            <div>
              <dt>Timeline</dt>
              <dd>{d.years}</dd>
            </div>
          ) : null}
          {d.platforms ? (
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms}</dd>
            </div>
          ) : null}
          {d.tools ? (
            <div>
              <dt>Tools</dt>
              <dd>{d.tools}</dd>
            </div>
          ) : null}
          {d.status ? (
            <div>
              <dt>Status</dt>
              <dd>{d.status}</dd>
            </div>
          ) : null}
        </dl>
      ) : null
    }
    {
      heroMetrics ? (
        <div class="metrics">
          {confirmed.map((m) => (
            <div class="metric">
              <span class="value">{m.value}</span>
              <span>{m.label}</span>
            </div>
          ))}
        </div>
      ) : null
    }
    {
      d.video?.section === "header" ? (
        <WorkVideo
          src={d.video.src}
          poster={d.video.poster}
          caption={d.video.caption}
          fallbackAlt={d.video.fallbackAlt}
          maxCssPx={400}
        />
      ) : v.header ? (
        <Figure {...v.header} priority />
      ) : null
    }
    {(gallery.header ?? []).map((item, i) => (
      <Figure {...item} priority={i === 0 && !v.header} />
    ))}
    {
      clips
        .filter((c) => c.section === "header")
        .map((c) => <WorkVideo {...c} />)
    }
  </header>

  {
    d.tldr || confirmed.length ? (
      <section class="cs-section wrap">
        <h2>TL;DR</h2>
        {d.tldr ? <div class="prose" set:html={html(d.tldr)} /> : null}
        {
          !heroMetrics && confirmed.length ? (
            <div class="metrics">
              {confirmed.map((m) => (
                <div class="metric">
                  <span class="value">{m.value}</span>
                  <span>{m.label}</span>
                </div>
              ))}
            </div>
          ) : null
        }
        {v.tldr ? <Figure {...v.tldr} /> : null}
        {(gallery.tldr ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "tldr").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.overview ? (
      <section class="cs-section wrap">
        <h2>Overview</h2>
        <div class="prose" set:html={html(d.overview)} />
        {v.overview ? <Figure {...v.overview} /> : null}
        {(gallery.overview ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "overview").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.challenges.length ? (
      <section class="cs-section wrap">
        <h2>Challenge</h2>
        <div class="challenges">
          {d.challenges.map((c) => (
            <article class="challenge">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
        {v.challenge ? <Figure {...v.challenge} /> : null}
        {(gallery.challenge ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "challenge").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.solution || d.featureStage ? (
      <section class="cs-section wrap">
        {d.solution ? <h2>Solution</h2> : null}
        {d.solution ? <div class="prose" set:html={html(d.solution)} /> : null}
        {
          d.featureStage ? (
            <FeatureStage heading={d.featureStage.heading} items={d.featureStage.items} />
          ) : null
        }
        {v.solution ? <Figure {...v.solution} /> : null}
        {(gallery.solution ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "solution").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.research || quotes.length ? (
      <section class="cs-section wrap">
        {d.research ? <h2>{d.researchHeading}</h2> : null}
        {d.research ? <div class="prose" set:html={html(d.research)} /> : null}
        {
          quotes.length ? (
            <div class="research-heard">
              <h3>What we heard in research</h3>
              <ul class="research-quotes">
                {quotes.map((q) => (
                  <li>
                    <blockquote class="research-quote">
                      <p>{q.quote}</p>
                      <footer>
                        <span class="rq-avatar" aria-hidden="true">
                          {initials(q.name)}
                        </span>
                        <span class="rq-id">
                          <cite class="rq-name">{q.name}</cite>
                          {q.context ? <span class="rq-context">{q.context}</span> : null}
                        </span>
                      </footer>
                    </blockquote>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }
        {v.research ? <Figure {...v.research} /> : null}
        {(gallery.research ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "research").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.decisions ? (
      <section class="cs-section wrap">
        <h2>Design Decisions</h2>
        <div class="prose" set:html={html(d.decisions)} />
        {v.decisions ? <Figure {...v.decisions} /> : null}
        {(gallery.decisions ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "decisions").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.outcome ? (
      <section class="cs-section wrap">
        <h2>Outcome</h2>
        <div class="prose" set:html={html(d.outcome)} />
        {v.outcome ? <Figure {...v.outcome} /> : null}
        {(gallery.outcome ?? []).map((item) => <Figure {...item} />)}
        {clips.filter((c) => c.section === "outcome").map((c) => <WorkVideo {...c} />)}
      </section>
    ) : null
  }

  {
    d.reflection ? (
      <section class="cs-section wrap">
        <h2>Reflection</h2>
        <div class="prose" set:html={html(d.reflection)} />
        {v.reflection ? <Figure {...v.reflection} /> : null}
      </section>
    ) : null
  }

  {
    next ? (
      <nav class="next wrap">
        <span>Next case study</span>
        <a href={`/work/${next.id}`}>
          {nextBadge ? `${nextBadge} · ` : ""}
          {next.data.title}
        </a>
      </nav>
    ) : null
  }
</article>
