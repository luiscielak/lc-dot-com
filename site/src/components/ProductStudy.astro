---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import PhoneStage from "./PhoneStage.astro";
import { renderProse } from "../lib/prose";

interface Props {
  entry: CollectionEntry<"work">;
  next?: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const d = entry.data;
const figures = d.figures ?? {};

function html(s?: string) {
  return s ? renderProse(s) : "";
}

type FigureProps = {
  src: string;
  srcMobile?: string;
  alt: string;
  caption?: string;
  maxCssPx?: number;
  phone?: boolean;
  framed?: boolean;
};

type Subhead = {
  heading?: string;
  body: string;
  figure?: FigureProps;
};

function splitSubheads(
  text: string,
  figureFor: Record<string, FigureProps | undefined>,
): Subhead[] {
  const chunks = text.split(/^(### .+)$/m);
  const out: Subhead[] = [];
  const preamble = chunks[0]?.trim();
  if (preamble) out.push({ body: preamble, figure: figureFor[""] });
  for (let i = 1; i < chunks.length; i += 2) {
    const heading = chunks[i].replace(/^###\s+/, "").trim();
    const body = (chunks[i + 1] ?? "").trim();
    out.push({ heading, body, figure: figureFor[heading] });
  }
  return out;
}

type Band = {
  heading: string;
  html?: string;
  parts?: Subhead[];
};

const bands: Band[] = [];
if (d.research) bands.push({ heading: d.researchHeading, html: html(d.research) });
if (d.solution) {
  bands.push({
    heading: "A small organization",
    parts: [{ body: d.solution, figure: figures.system }],
  });
}
if (d.decisions) {
  bands.push({
    heading: "The permission matrix",
    parts: splitSubheads(d.decisions, {
      "": figures.permissions,
      "The approval moment": figures.approval,
      "Two surfaces, on purpose": figures.surfaces,
    }),
  });
}
if (d.outcome) {
  bands.push({
    heading: "In daily use",
    parts: splitSubheads(d.outcome, {
      "Running Cursor Philly": figures.philly,
      "A bug, from screenshot to fix": figures.bugflow,
      "The design squad": figures.cockpit,
    }),
  });
}
---

<article class="product-study">
  <header class="ps-hero wrap">
    <p class="ps-kicker">
      {d.draft ? <span class="badge">Draft</span> : null}
      Case study
    </p>
    <h1>{d.title}</h1>
    <p class="ps-sub">{d.subtitle}</p>
    {d.tldr ? <div class="prose ps-lede" set:html={html(d.tldr)} /> : null}
    {
      d.cover ? (
        <div class="ps-hero-figure ps-panel">
          <Figure
            src={d.cover}
            srcMobile={d.coverMobile}
            alt={d.coverAlt}
            maxCssPx={d.coverMaxCssPx}
            priority
          />
        </div>
      ) : null
    }
    {
      d.role || d.platforms || d.tools || d.status || d.company || d.years ? (
        <dl class="meta-row ps-meta">
          {d.company ? (
            <div>
              <dt>Company</dt>
              <dd>{d.company}</dd>
            </div>
          ) : null}
          {d.role ? (
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
          ) : null}
          {d.years ? (
            <div>
              <dt>Timeline</dt>
              <dd>{d.years}</dd>
            </div>
          ) : null}
          {d.platforms ? (
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms}</dd>
            </div>
          ) : null}
          {d.tools ? (
            <div>
              <dt>Tools</dt>
              <dd>{d.tools}</dd>
            </div>
          ) : null}
          {d.status ? (
            <div>
              <dt>Status</dt>
              <dd>{d.status}</dd>
            </div>
          ) : null}
        </dl>
      ) : null
    }
    {d.overview ? <div class="prose ps-overview" set:html={html(d.overview)} /> : null}
  </header>

  {
    d.challenges.length ? (
      <section class="ps-principles wrap" aria-label="Design principles">
        <ul>
          {d.challenges.map((c) => (
            <li>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    d.phones?.length ? (
      <section class="ps-band ps-phones wrap" aria-labelledby="ps-phones-title">
        <div class="ps-band-head">
          <h2 id="ps-phones-title">Where it reaches me</h2>
          <p>
            Telegram for quick captures, status, and the morning brief. Slack for real work, one
            thread per task.
          </p>
        </div>
        <PhoneStage phones={d.phones} />
      </section>
    ) : null
  }

  {
    bands.map((band) => (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>{band.heading}</h2>
        </div>
        {band.html ? <div class="prose" set:html={band.html} /> : null}
        {band.parts?.map((part) => (
          <>
            {part.heading ? <h3 class="ps-subhead">{part.heading}</h3> : null}
            {part.body ? <div class="prose" set:html={html(part.body)} /> : null}
            {part.figure ? (
              <div class="ps-panel">
                <Figure {...part.figure} maxCssPx={part.figure.maxCssPx ?? 1200} />
              </div>
            ) : null}
          </>
        ))}
      </section>
    ))
  }

  {
    d.reflection ? (
      <section class="ps-close wrap">
        <div class="prose" set:html={html(d.reflection)} />
      </section>
    ) : null
  }

  {
    next ? (
      <nav class="next wrap">
        <span>Next case study</span>
        <a href={`/work/${next.id}`}>
          {next.data.draft ? "Draft · " : ""}
          {next.data.title}
        </a>
      </nav>
    ) : null
  }
</article>
