---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const studies = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

/** Poster copy from Paper, Landing 3 — Bold (Inverted Nameplate). */
const plate = [
  {
    id: "field-dispatch",
    index: "01",
    domain: "Logistics",
    title: "MSS Specialty Services",
    blurb: "Workflow platform for specialty moving ops.",
  },
  {
    id: "pmi-disciplined-agile",
    index: "02",
    domain: "Certification",
    title: "PMI Disciplined Agile",
    blurb: "Mobile-first PWA for agile coaches.",
  },
  {
    id: "straatclaw",
    index: "03",
    domain: "AI field tool",
    title: "StraatClaw",
    blurb: "Agent-assisted tool for field operators.",
  },
];

const featured = plate.flatMap((item) => {
  const study = studies.find((s) => s.id === item.id);
  if (!study) return [];
  return [{ ...item, draft: study.data.draft }];
});

const moreCount = studies.length - featured.length;
---

<Base
  nameplate
  title="Luis Cielak — Clarity above all."
  description="I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next."
>
  <header class="plate-bar" slot="banner">
    <a class="plate-name" href="/">Luis Cielak</a>
    <p class="plate-status">
      <span>Product design lead</span>
    </p>
    <nav class="plate-nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="/about">About</a>
      <a href="/resume">Résumé</a>
      <a href="mailto:luis@luiscielak.com">Contact</a>
    </nav>
  </header>

  <div class="nameplate">
    <section class="plate-hero" aria-labelledby="plate-title">
      <p class="plate-kicker">Fifteen years of operational products</p>
      <h1 id="plate-title">Clarity<br />above all.</h1>
    </section>

    <div class="plate-intro">
      <p class="plate-bio">
        I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next.
      </p>
      <div class="plate-actions">
        <a class="plate-btn" href="#work">View work →</a>
        <a class="plate-btn plate-btn-ghost" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
      </div>
    </div>

    <ul class="plate-strip">
      {
        featured.map((item) => (
          <li>
            <a href={`/work/${item.id}`}>
              <span class="plate-kicker-row">
                <span class="plate-index">
                  {item.index} / {item.domain}
                </span>
                {item.draft ? <span class="plate-draft">Draft</span> : null}
              </span>
              <span class="plate-study">{item.title}</span>
              <span class="plate-blurb">{item.blurb}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="plate-more" href="#work">
          <span class="plate-more-count">+ {moreCount} more</span>
          <span class="plate-all">All work →</span>
        </a>
      </li>
    </ul>

    <section class="plate-catalog" id="work" aria-labelledby="all-work">
      <h2 id="all-work">All work</h2>
      <ol>
        {
          studies.map((study, i) => (
            <li>
              <a href={`/work/${study.id}`}>
                <span class="plate-index">
                  {String(i + 1).padStart(2, "0")}
                  {study.data.company ? ` / ${study.data.company}` : ""}
                </span>
                <span class="plate-study">{study.data.title}</span>
                <span class="plate-blurb">{study.data.subtitle}</span>
                {study.data.draft ? <span class="plate-draft">Draft</span> : null}
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>
