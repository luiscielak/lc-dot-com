---
import { getCollection } from "astro:content";
import portrait from "../assets/portrait.jpg";
import BrandLockup from "../components/BrandLockup.astro";
import Base from "../layouts/Base.astro";

const studies = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

/**
 * Featured proof: the two strongest published cases, in the order the hero
 * promises. Only cases with a real page are featured — no "case study soon"
 * placeholders in the first position a hiring manager reads.
 */
const plate = [
  {
    id: "pmi-partner-platform",
    index: "01",
    domain: "Certification",
    title: "PMI Partner Platform",
    blurb: "Self-service platform that replaced manual B2B workflows.",
    // TODO(Luis): revenue result omitted until one figure is confirmed. The résumé
    // says $3.75M first-year revenue / +30% conversion; the old live page said $3.1M;
    // the case frontmatter keeps disputed dollars out of the metric row. Pick one,
    // then add `result: "..."` here to render a result line on this card.
  },
  {
    id: "field-dispatch",
    index: "02",
    domain: "Logistics",
    title: "MSS Specialty Services",
    blurb: "Workflow platform for specialty moving ops.",
    result: "47% faster dispatch",
  },
];

const featured = plate.flatMap((item) => {
  const study = studies.find((s) => s.id === item.id);
  if (!study) return [];
  return [{ ...item, draft: study.data.draft }];
});

const featuredIds = new Set(plate.map((item) => item.id));

/** Everything else, numbered continuously after the featured strip. */
const moreWork = studies.filter((study) => !featuredIds.has(study.id));

/** Logo lockup after the work catalog. Width and height are the rendered pixel size. */
const clients = [
  { name: "Vanguard", src: "/logos/clients/vanguard.png", width: 105, height: 22 },
  { name: "JPMorgan Chase", src: "/logos/clients/jpmc.png", width: 231, height: 15 },
  { name: "PMI", src: "/logos/clients/pmi.svg", width: 131, height: 40 },
  { name: "FM", src: "/logos/clients/fm.png", width: 48, height: 24, quiet: true },
  { name: "Elsevier", src: "/logos/clients/elsevier.png", width: 37, height: 40 },
  { name: "Ford", src: "/logos/clients/ford.png", width: 78, height: 28 },
  { name: "USA.gov", src: "/logos/clients/usagov.png", width: 41, height: 36 },
  { name: "Celgene", src: "/logos/clients/celgene.png", width: 41, height: 36 },
  { name: "Westat", src: "/logos/clients/westat.png", width: 76, height: 20 },
];

/**
 * Testimonials — LinkedIn recommendations. `quote` is a verbatim pull-quote
 * from each recommendation (kept short so the cards stay compact); the full
 * text lives on LinkedIn.
 *
 * Two layouts live here: "list" (stacked rows) and "cards" (bordered card
 * carousel, inspired by the Save.design testimonials section). Flip
 * `testimonialsLayout` to switch.
 */
const testimonialsLayout: "cards" | "list" = "cards";

const testimonials = [
  {
    index: "01",
    quote: "Luis is the kind of designer who makes teams better simply by being part of them.",
    name: "Michael Pacheco",
    role: "Lead UX Designer · PMI",
  },
  {
    index: "02",
    quote:
      "Luis brings sharp insight, expert design skill, and strategic clarity to everything he touches.",
    name: "Keriann Sabatini",
    role: "Principal Product Manager · PMI",
  },
  {
    index: "03",
    quote:
      "Luis is incredibly talented at getting senior stakeholders on the same page through his masterful UX workshops.",
    name: "James Brown",
    role: "Sr. Experience Design Manager · FM",
  },
  {
    index: "04",
    quote:
      "A talented UX designer with an excellent ability to facilitate, shape, and collaborate in the early phases of work.",
    name: "El Cruz",
    role: "Senior Manager, Experience Design · FM",
  },
  {
    index: "05",
    quote:
      "Any team would be lucky to have Luis; he brings not only talent but a mindset that elevates every project he touches.",
    name: "Danielle Trombino",
    role: "Senior Product Owner · FM Global",
  },
  {
    index: "06",
    quote:
      "His design approach helped lead the B2B platform redesign that drove $3.1M in revenue in the first year and eliminated $650K in losses.",
    name: "Patrick Olivares",
    role: "Executive Product Leader · PMI",
  },
  {
    index: "07",
    quote:
      "Luis is a talented UI/UX expert who brings clarity and innovation to every project and works well with product and engineering teams.",
    name: "Ankur Pariyani",
    role: "Co-Founder & CIO · Near-Miss Management",
  },
  {
    index: "08",
    quote:
      "He has a way of seeing the best in people, creating a space where everyone feels heard and valued.",
    name: "Shauna Mensah",
    role: "Operations Manager · PMI",
  },
];

/** Practice lines from the About section. */
const practice = [
  {
    title: "User Experience",
    body: "The path through a complicated product, so the next step is obvious when it matters.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="7" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="23" cy="15" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="23" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 9.4c4.2.4 7 3.2 7 5.6h4.6M16 15c0 3.4-2.6 6.2-5.2 6.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
  {
    title: "User Research",
    body: "Time with the people doing the job, used to change the plan — not to decorate it.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 22.5v-1.2c0-2.6 2.9-4.6 6.5-4.6s6.5 2 6.5 4.6v1.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
  {
    title: "Interface Design",
    body: "Structure, rhythm, and a system so a dense product stays calm as it grows.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><rect x="5" y="6" width="9" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="16" y="6" width="9" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="5" y="16" width="20" height="8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
  },
  {
    title: "Data Visualization",
    body: "The few signals someone needs in order to decide, not every number the system can show.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path d="M6 23V17M12 23V11M18 23V14M24 23V8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
];
---

<Base
  nameplate
  title="Luis Cielak — Clarity above all."
  description="I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next."
>
  <header class="plate-bar" slot="banner">
    <BrandLockup tone="paper" class="plate-name" />
    <p class="plate-status">
      <span>Lead Product Designer</span>
    </p>
    <nav class="plate-nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="/resume">Résumé</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <div class="nameplate">
    <div class="plate-stage">
      <canvas class="plate-field" aria-hidden="true"></canvas>

      <section class="plate-hero" aria-labelledby="plate-title">
        <p class="plate-kicker">AI &amp; Enterprise Platforms</p>
        <h1 id="plate-title">Clarity<br />above all<span class="plate-period">.</span></h1>
      </section>

      <div class="plate-intro">
        {/* TODO(Luis): link "Cursor Philly" once the community URL is confirmed. */}
        <p class="plate-bio">
          I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next. Lately that work includes AI-assisted tools and workflows, and organizing Cursor Philly, a community for designers and builders.
        </p>
        <div class="plate-actions">
          <a class="plate-btn" href="#work">View work <span class="plate-btn-arrow" aria-hidden="true">→</span></a>
          <a class="plate-btn plate-btn-ghost" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
        </div>
      </div>
    </div>

    <ul class="plate-strip" id="work">
      {
        featured.map((item) => (
          <li>
            <a href={`/work/${item.id}`}>
              <span class="plate-kicker-row">
                <span class="plate-index">
                  {item.index} / {item.domain}
                </span>
                {item.draft ? <span class="plate-draft">Draft</span> : null}
              </span>
              <span class="plate-study">{item.title}</span>
              <span class="plate-blurb">{item.blurb}</span>
              {item.result ? <span class="plate-result">{item.result}</span> : null}
              <svg
                class="plate-card-arrow"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.25" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="plate-clients" aria-labelledby="clients-label">
      <p id="clients-label">Selected clients &amp; employers</p>
      <div class="plate-client-marquee">
        <div class="plate-client-track">
          {
            [false, true].map((clone) => (
              <ul class="plate-client-group" aria-hidden={clone ? "true" : undefined}>
                {
                  clients.map((client) => (
                    <li>
                      <img
                        class:list={{ "is-quiet": "quiet" in client && client.quiet }}
                        src={client.src}
                        alt={clone ? "" : client.name}
                        width={client.width}
                        height={client.height}
                        draggable="false"
                      />
                    </li>
                  ))
                }
              </ul>
            ))
          }
        </div>
      </div>
    </section>

    <section class="plate-catalog" aria-labelledby="more-work">
      <h2 id="more-work">More work</h2>
      <ol>
        {
          moreWork.map((study, i) => (
            <li>
              <a href={`/work/${study.id}`}>
                <span class="plate-index">
                  {String(featured.length + i + 1).padStart(2, "0")}
                  {study.data.company ? ` / ${study.data.company}` : ""}
                </span>
                <span class="plate-study">{study.data.title}</span>
                <span class="plate-blurb">{study.data.subtitle}</span>
                {study.data.draft ? <span class="plate-draft">Draft</span> : null}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      testimonialsLayout === "cards" ? (
        <section class="plate-quotes plate-quotes--cards" aria-labelledby="testimonials">
          <div class="plate-quotes-head">
            <h2 id="testimonials">Testimonials</h2>
            <div class="plate-quote-nav">
              <button type="button" class="plate-quote-arrow" data-marquee="prev" aria-label="Previous testimonial">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="plate-quote-arrow" data-marquee="next" aria-label="Next testimonial">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
          <div class="plate-quote-marquee">
            <div class="plate-quote-track">
              {[false, true].map((clone) => (
                <ul class="plate-quote-group" aria-hidden={clone ? "true" : undefined}>
                  {testimonials.map((item) => (
                    <li>
                      <blockquote>
                        <span class="pqc-mark" aria-hidden="true">”</span>
                        <p class="plate-quote-text">{item.quote}</p>
                        <footer class="pqc-foot">
                          <span class="pqc-id">
                            <span class="pqc-name">{item.name.split(" ")[0]}</span>
                            <span class="pqc-role">{item.role.split(" · ")[0]}</span>
                          </span>
                          {/* LinkedIn slot — becomes a real link once profiles are confirmed. */}
                          <span class="pqc-link" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24">
                              <path
                                d="M5 9.5V19M5 5.5h.01M10 19V9.5M10 13.2c0-2.1 1.6-3.7 3.7-3.7 2 0 3.3 1.2 3.3 3.6V19"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </span>
                        </footer>
                      </blockquote>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="plate-quotes" aria-labelledby="testimonials">
          <h2 id="testimonials">Testimonials</h2>
          <ul>
            {testimonials.map((item) => (
              <li>
                <blockquote>
                  <span class="plate-quote-meta">
                    <span class="plate-index">{item.index}</span>
                  </span>
                  <p class="plate-quote-text">{item.quote}</p>
                  <footer>
                    <cite class="plate-quote-cite">
                      {item.name} · {item.role}
                    </cite>
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="about" id="about" aria-labelledby="about-title">
      <div class="about-intro">
        <div class="about-copy">
          <p class="about-kicker">
            <span class="about-dot" aria-hidden="true"></span>
            Product design for complex systems
          </p>
          <h2 id="about-title">
            I help product teams<br />
            bring clarity to tools<br />
            people rely on<br />
            under pressure.
          </h2>
          <p class="about-closer">
            Rooted in research. Guided by systems. Delivered with care.
          </p>
          <p class="about-fact">Philadelphia, originally from Mexico City.</p>
        </div>
        <img
          class="about-portrait"
          src={portrait.src}
          width={portrait.width}
          height={portrait.height}
          alt="Portrait of Luis Cielak"
        />
      </div>

      <div class="about-practice" aria-label="Practice">
        {
          practice.map((item) => (
            <article>
              <h3>
                <span class="about-icon" set:html={item.icon} />
                {item.title}
              </h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="plate-contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <div class="about-contact">
        <div class="about-socials">
          <a href="https://www.linkedin.com/in/cielak" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 9.5V19M5 5.5h.01M10 19V9.5M10 13.2c0-2.1 1.6-3.7 3.7-3.7 2 0 3.3 1.2 3.3 3.6V19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="https://github.com/luiscielak" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.66-.18 1.36-.27 2.06-.27.7 0 1.4.09 2.06.27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" fill="currentColor"></path>
            </svg>
          </a>
          <a href="mailto:luis@luiscielak.com" aria-label="Email">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
              <path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <a class="about-email" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountClientMarquee } from "../scripts/client-marquee";
  import { mountSignalField } from "../scripts/signal-field";
  import { mountTestimonialMarquee } from "../scripts/testimonial-marquee";

  mountSignalField();
  mountClientMarquee();
  mountTestimonialMarquee();
</script>
