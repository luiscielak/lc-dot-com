---
import { Picture } from "astro:assets";
import { workImage } from "../lib/images";

interface Props {
  src: string;
  poster: string;
  caption: string;
  fallbackAlt: string;
  maxCssPx: number;
  /** Phone-width frame. Desktop recordings leave this off. */
  phone?: boolean;
}

const { src, poster, caption, fallbackAlt, maxCssPx, phone = true } = Astro.props;
const posterImage = workImage(poster);
const cap = Math.min(maxCssPx, Math.floor(posterImage.width / 1.5));
const capId = `work-loop-cap-${src.replace(/[^a-z0-9]+/gi, "-")}`;
---

<figure
  class:list={["figure", phone && "phone"]}
  style={phone ? `--phone-max: ${cap}px` : `--figure-max: ${cap}px`}
  data-src={poster}
  data-src-width={posterImage.width}
  data-render-max={cap}
>
  <div class="work-loop-stage">
    <video
      class="js-loop-video"
      muted
      loop
      playsinline
      poster={posterImage.src}
      aria-labelledby={capId}
    >
      <source src={src} type="video/mp4" />
    </video>
    <div class="js-video-fallback" hidden>
      <Picture
        src={posterImage}
        alt={fallbackAlt}
        formats={["avif", "webp"]}
        widths={[640, 960]}
        sizes={`min(100vw - 2rem, ${cap}px)`}
      />
    </div>
    <button type="button" class="work-loop-toggle" data-loop-toggle>
      Play
    </button>
  </div>
  <figcaption id={capId}>{caption}</figcaption>
</figure>

<script>
  import { mountLoopVideos } from "../scripts/loop-video";
  mountLoopVideos();
</script>
