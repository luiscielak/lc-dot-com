---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import FeatureStage from "./FeatureStage.astro";
import WorkVideo from "./WorkVideo.astro";
import { renderProse } from "../lib/prose";

interface Props {
  entry: CollectionEntry<"work">;
  next?: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const d = entry.data;
const confirmed = d.metrics.filter((m) => m.confirmed).slice(0, 3);
const v = d.visuals;

function html(s?: string) {
  return s ? renderProse(s) : "";
}
---

<article>
  <header class="cs-header wrap">
    <p class="cs-kicker">
      {d.draft ? <span class="badge">Draft</span> : null}
      Case study
    </p>
    <h1>{d.title}</h1>
    <p class="cs-sub">{d.subtitle}</p>
    {
      d.recreatedNote ? (
        <p class="note">{d.recreatedNote}</p>
      ) : null
    }
    {
      d.company || d.role || d.years || d.status || d.platforms || d.tools ? (
        <dl class="meta-row">
          {d.company ? (
            <div>
              <dt>Company</dt>
              <dd>{d.company}</dd>
            </div>
          ) : null}
          {d.role ? (
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
          ) : null}
          {d.years ? (
            <div>
              <dt>Timeline</dt>
              <dd>{d.years}</dd>
            </div>
          ) : null}
          {d.platforms ? (
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms}</dd>
            </div>
          ) : null}
          {d.tools ? (
            <div>
              <dt>Tools</dt>
              <dd>{d.tools}</dd>
            </div>
          ) : null}
          {d.status ? (
            <div>
              <dt>Status</dt>
              <dd>{d.status}</dd>
            </div>
          ) : null}
        </dl>
      ) : null
    }
    {
      d.video?.section === "header" ? (
        <WorkVideo
          src={d.video.src}
          poster={d.video.poster}
          caption={d.video.caption}
          fallbackAlt={d.video.fallbackAlt}
          maxCssPx={400}
        />
      ) : v.header ? (
        <Figure {...v.header} />
      ) : null
    }
  </header>

  {
    d.tldr || confirmed.length ? (
      <section class="cs-section wrap">
        <h2>TL;DR</h2>
        {d.tldr ? <div class="prose" set:html={html(d.tldr)} /> : null}
        {
          confirmed.length ? (
            <div class="metrics">
              {confirmed.map((m) => (
                <div class="metric">
                  <span class="value">{m.value}</span>
                  <span>{m.label}</span>
                </div>
              ))}
            </div>
          ) : null
        }
        {v.tldr ? <Figure {...v.tldr} /> : null}
      </section>
    ) : null
  }

  {
    d.overview ? (
      <section class="cs-section wrap">
        <h2>Overview</h2>
        <div class="prose" set:html={html(d.overview)} />
        {v.overview ? <Figure {...v.overview} /> : null}
      </section>
    ) : null
  }

  {
    d.challenges.length ? (
      <section class="cs-section wrap">
        <h2>Challenge</h2>
        <div class="challenges">
          {d.challenges.map((c) => (
            <article class="challenge">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
        {v.challenge ? <Figure {...v.challenge} /> : null}
      </section>
    ) : null
  }

  {
    d.solution || d.featureStage ? (
      <section class="cs-section wrap">
        {d.solution ? <h2>Solution</h2> : null}
        {d.solution ? <div class="prose" set:html={html(d.solution)} /> : null}
        {
          d.featureStage ? (
            <FeatureStage heading={d.featureStage.heading} items={d.featureStage.items} />
          ) : null
        }
        {v.solution ? <Figure {...v.solution} /> : null}
      </section>
    ) : null
  }

  {
    d.research ? (
      <section class="cs-section wrap">
        <h2>{d.researchHeading}</h2>
        <div class="prose" set:html={html(d.research)} />
        {v.research ? <Figure {...v.research} /> : null}
      </section>
    ) : null
  }

  {
    d.decisions ? (
      <section class="cs-section wrap">
        <h2>Design Decisions</h2>
        <div class="prose" set:html={html(d.decisions)} />
        {v.decisions ? <Figure {...v.decisions} /> : null}
      </section>
    ) : null
  }

  {
    d.outcome ? (
      <section class="cs-section wrap">
        <h2>Outcome</h2>
        <div class="prose" set:html={html(d.outcome)} />
        {v.outcome ? <Figure {...v.outcome} /> : null}
      </section>
    ) : null
  }

  {
    d.reflection ? (
      <section class="cs-section wrap">
        <h2>Reflection</h2>
        <div class="prose" set:html={html(d.reflection)} />
        {v.reflection ? <Figure {...v.reflection} /> : null}
      </section>
    ) : null
  }

  {
    next ? (
      <nav class="next wrap">
        <span>Next case study</span>
        <a href={`/work/${next.id}`}>
          {next.data.draft ? "Draft · " : ""}
          {next.data.title}
        </a>
      </nav>
    ) : null
  }
</article>
