{
  "$meta": {
    "name": "first-week-concept / monarch-inspired tokens",
    "status": "Inspired-by tokens for an UNOFFICIAL concept. Values are deliberately close to, not identical to, Monarch's. See brief.md for the source value each one is derived from.",
    "sources": {
      "app_css": "https://static.monarch.com/static/css/main.cd5173a6.css (fetched 2026-10-29)",
      "app_js_theme": "https://static.monarch.com/static/js/main.746e4365.js (fetched 2026-10-29)",
      "marketing_css": "https://www.monarch.com/_next/static/immutable/chunks/3t1joj5lb-6y9.css (fetched 2026-10-29)",
      "open_palette": "Radix Colors (MIT), https://www.radix-ui.com/colors. Monarch's own scales are built on it."
    }
  },
  "color": {
    "brand": {
      "accent":        { "value": "#F76B15", "derivedFrom": "Monarch orange-9 #FF692D; this is Radix orange-9" },
      "accentHover":   { "value": "#EF5F00", "derivedFrom": "Monarch orange-10 #F35B16; Radix orange-10" },
      "accentText":    { "value": "#CC4E00", "derivedFrom": "Monarch orange-11 #D64700; Radix orange-11" },
      "accentSubtle":  { "value": "#FFEFD6", "derivedFrom": "Monarch orange-3 #FFE9DE; Radix orange-3" },
      "heroWash":      { "value": "#FDF6F1", "derivedFrom": "approx, sampled from App Store screenshot backgrounds (peach wash)" }
    },
    "neutral": {
      "gray1":  { "value": "#FDFDFC", "derivedFrom": "Monarch gray-1 #FBFAF8; Radix sand-1" },
      "gray2":  { "value": "#F9F9F8", "derivedFrom": "Monarch gray-2 #F6F5F3 (background-page); Radix sand-2" },
      "gray3":  { "value": "#F1F0EF", "derivedFrom": "Monarch gray-3 #EFECE9" },
      "gray4":  { "value": "#E9E8E6", "derivedFrom": "Monarch gray-4 #EBE8E5 (progress-background)" },
      "gray5":  { "value": "#E2E1DE", "derivedFrom": "Monarch gray-5 #E4E1DE (border-primary)" },
      "gray6":  { "value": "#DAD9D6", "derivedFrom": "Monarch gray-6 #DCD9D6 (input border)" },
      "gray8":  { "value": "#BCBBB5", "derivedFrom": "Monarch gray-8 #BEBBB8" },
      "gray9":  { "value": "#8D8D86", "derivedFrom": "Monarch gray-9 #8F8C8A (placeholder)" },
      "gray11": { "value": "#63635E", "derivedFrom": "Monarch gray-11 #777573 (content-secondary). Darker here for AA on gray2." },
      "gray12": { "value": "#21201C", "derivedFrom": "Monarch gray-12 #22201D (content-primary)" },
      "white":  { "value": "#FFFFFF", "derivedFrom": "Monarch background-primary / background-card = pure-white" }
    },
    "semantic": {
      "background.page":    { "ref": "neutral.gray2" },
      "background.card":    { "ref": "neutral.white" },
      "content.primary":    { "ref": "neutral.gray12" },
      "content.secondary":  { "ref": "neutral.gray11" },
      "border.primary":     { "ref": "neutral.gray5" },
      "divider":            { "ref": "neutral.gray3" },
      "success":            { "value": "#218358", "bg": "#E6F6EB", "bold": "#30A46C", "derivedFrom": "Monarch green-11/3/9 = Radix green" },
      "warning":            { "value": "#AB6400", "bg": "#FFF7C2", "bold": "#FFC53D", "derivedFrom": "Monarch yellow-11/3/9 = Radix amber" },
      "danger":             { "value": "#CE2C31", "bg": "#FEEBEC", "bold": "#E5484D", "derivedFrom": "Monarch red-11/3/9 = Radix red" },
      "info":               { "value": "#107D98", "bg": "#DEF7F9", "bold": "#00A2C7", "derivedFrom": "Monarch blue-11/3/9 = Radix cyan" },
      "link":               { "value": "#0797B9", "derivedFrom": "Monarch content-link = blue-10" },
      "focusRing":          { "value": "#00A2C7", "derivedFrom": "Monarch input-focus-border = blue-9" },
      "ai":                 { "value": "#8E4EC6", "bg": "#F7EDFE", "derivedFrom": "Monarch content-purple purple-9 / background-purple purple-3 (assumed AI/sparkle use, not confirmed)" }
    },
    "money": {
      "positive":   { "value": "#218358", "note": "income / gains, e.g. '+$4,000.00' in Goals screenshot" },
      "negative":   { "value": "#21201C", "note": "spending stays neutral text in lists; red is reserved for over-budget" },
      "overBudget": { "value": "#E5484D" }
    },
    "chart": {
      "income":          { "value": "#ADDDC0", "active": "#30A46C", "derivedFrom": "chart-income green-6 / active green-9" },
      "expenses":        { "value": "#FDBDBE", "active": "#E5484D", "derivedFrom": "chart-expenses red-6 / active red-9" },
      "line":            { "value": "#21201C", "derivedFrom": "chart-line gray-12" },
      "netWorthLine":    { "value": "#00A2C7", "derivedFrom": "approx, Accounts screenshot net-worth line (cyan)" },
      "axis":            { "value": "#F1F0EF", "derivedFrom": "chart-axis gray-3" },
      "label":           { "value": "#8D8D86", "derivedFrom": "chart-label gray-10" },
      "budgetBar.track": { "ref": "neutral.gray4" },
      "budgetBar.under": { "value": "#30A46C" },
      "budgetBar.onPace":{ "value": "#FFC53D" },
      "budgetBar.over":  { "value": "#E5484D" }
    },
    "tag": {
      "note": "Monarch's tag swatch order: red, orange, yellow, lime, mint, sky, green, blue, indigo, purple, pink, brown (all *-9). Pastel 'background' + dark 'filled' pairs are used for avatars/chips.",
      "red":    { "bg": "#FEEBEC", "fg": "#CE2C31" },
      "orange": { "bg": "#FFEFD6", "fg": "#CC4E00" },
      "yellow": { "bg": "#FFF7C2", "fg": "#AB6400" },
      "lime":   { "bg": "#EEF6D6", "fg": "#5C7C2F" },
      "teal":   { "bg": "#E0F8F3", "fg": "#008573" },
      "cyan":   { "bg": "#DEF7F9", "fg": "#107D98" },
      "indigo": { "bg": "#EDF2FE", "fg": "#3A5BC7" },
      "purple": { "bg": "#F7EDFE", "fg": "#8145B5" },
      "pink":   { "bg": "#FEE9F5", "fg": "#C2298A" },
      "brown":  { "bg": "#F6EEE7", "fg": "#815E46" }
    }
  },
  "type": {
    "family": {
      "ui":      { "value": "'Inter', 'DM Sans', system-ui, sans-serif", "derivedFrom": "Monarch --font-primary 'Oracle' (ABC Oracle, proprietary). Substitute is a judgment call." },
      "display": { "value": "'Newsreader', Georgia, serif", "derivedFrom": "Monarch --font-secondary 'Copernicus' (proprietary). Marketing and big headlines only, with italic for emphasis." },
      "mono":    { "value": "ui-monospace, SFMono-Regular, Menlo, monospace", "derivedFrom": "Monarch --font-mono (same stack)" }
    },
    "weight": { "book": 400, "medium": 500, "bold": 600, "derivedFrom": "Monarch --font-weight-book normal / medium 500 / bold 600" },
    "size": {
      "2xs": "10px", "xs": "12px", "sm": "14px", "base": "16px", "lg": "18px", "20": "20px", "xl": "24px", "2xl": "30px", "3xl": "40px",
      "derivedFrom": "Monarch --text-* (identical scale; the scale is generic)"
    },
    "lineHeight": { "default": 1.5, "tight": 1.25, "snug": 1.375, "derivedFrom": "Monarch --text-*--line-height 150%, --leading-*" },
    "numeric": { "fontVariantNumeric": "tabular-nums", "derivedFrom": "Monarch uses the tabular-nums class on amounts" },
    "eyebrow": { "size": "14px", "weight": 500, "letterSpacing": "0.06em", "transform": "uppercase", "color": "brand.accent", "derivedFrom": "approx, App Store screenshot eyebrows (GOALS, CASH FLOW)" }
  },
  "radius": {
    "2xs": "4px", "xs": "6px", "sm": "8px", "default": "12px", "lg": "16px", "pill": "9999px",
    "card": "12px", "button": "8px", "chip": "9999px", "sheet": "16px",
    "derivedFrom": "Monarch --radius-2xs 4 / xs 6 / sm 8 / default 12 / lg 16 / pill 500px / round 9999px. card/button/chip/sheet mapping is approx, from screenshots."
  },
  "spacing": {
    "3xs": "2px", "2xs": "4px", "xs": "8px", "sm": "12px", "md": "14px", "default": "16px", "lg": "20px", "xl": "24px", "2xl": "32px", "3xl": "48px", "4xl": "64px",
    "gutter": "16px",
    "derivedFrom": "Monarch --space-* (4px base grid, gutter 16px)"
  },
  "size": {
    "button": { "xs": "28px", "sm": "32px", "md": "36px", "lg": "44px", "note": "Monarch padding tokens xsmall 5.5x12 / small 7.5x12 / medium 8x16 / large 10.5x16. Heights are approx." },
    "avatar": { "sm": "24px", "md": "32px", "lg": "48px", "note": "Monarch has a size map xxsmall 24 / xsmall 32 / small 36 / medium 40 / large 48 (likely avatar/icon containers, not confirmed)" },
    "tapTarget": "44px"
  },
  "shadow": {
    "sm":     { "value": "0px 1px 2px rgba(33,32,28,0.05)", "derivedFrom": "Monarch --shadow-sm 0 1px 2px gray-12 @5%" },
    "card":   { "value": "0px 2px 4px rgba(33,32,28,0.10)", "derivedFrom": "Monarch --shadow-card 0 2px 4px gray-12 @10%" },
    "lg":     { "value": "0px 3px 6px rgba(33,32,28,0.10)", "derivedFrom": "Monarch --shadow-lg" },
    "upcast": { "value": "0px -2px 4px rgba(33,32,28,0.10)", "derivedFrom": "Monarch --shadow-upcast (bottom bars and sheets)" },
    "frosted":{ "backdropFilter": "blur(12px)", "background": "rgba(253,253,252,0.92)", "derivedFrom": "Monarch --background-blur-frosted blur(12px), gray-1-o92" }
  },
  "motion": {
    "sparkle": { "easing": "cubic-bezier(.3,-.38,0,1.65)", "derivedFrom": "Monarch --ease-sparkle" },
    "standard": { "duration": "200ms", "easing": "ease-out", "note": "assumed, not found" }
  },
  "concept": {
    "unofficialBanner": { "bg": "#21201C", "fg": "#FFFFFF", "text": "Unofficial concept by Luis Cielak. Not affiliated with Monarch.", "height": "28px" }
  }
}
