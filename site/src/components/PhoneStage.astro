---
import { Picture } from "astro:assets";
import { workImage } from "../lib/images";

interface Phone {
  label: string;
  src: string;
  alt: string;
  caption: string;
  /** False when the image is a bare screenshot and the stage should draw the bezel. */
  framed?: boolean;
}

interface Props {
  phones: Phone[];
  /** Accessible name for the carousel. */
  label?: string;
}

const { phones, label = "Product screens on the phone" } = Astro.props;

/** Keep in sync with PHONE_MAX in scripts/check-image-resolution.mjs. */
const CENTER_MAX = 320;

const slides = phones.map((p) => {
  const image = workImage(p.src);
  const widths = [320, 480, 640, 960].filter((w) => w <= image.width);
  return { ...p, image, widths: widths.length ? widths : [image.width] };
});

const maxRatio = Math.max(...slides.map((s) => s.image.height / s.image.width), 1.67);

/** Start centered on the first phone; neighbors fan out from there. */
const start = 0;
---

<section
  class="phone-stage"
  style={`--phone-center: ${CENTER_MAX}px; --phone-ratio: ${maxRatio}`}
  data-active={start}
  data-count={slides.length}
  aria-roledescription="carousel"
  aria-label={label}
  tabindex="0"
>
  <div class="phone-stage-viewport">
    <ul class="phone-stage-track">
      {
        slides.map((s, i) => (
          <li class="phone-slide" data-index={i} aria-hidden={i === start ? "false" : "true"}>
            <div class="phone-slide-stack">
              <span class="phone-slide-label">{s.label}</span>
              <div class:list={["phone-slide-frame", s.framed === false && "is-screen"]}>
                <Picture
                  src={s.image}
                  alt={s.alt}
                  formats={["avif", "webp"]}
                  widths={s.widths}
                  sizes={`${CENTER_MAX}px`}
                  loading={i === start ? "eager" : "lazy"}
                />
              </div>
              <p class="phone-slide-caption">{s.caption}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  {
    slides.length > 1 ? (
      <div class="phone-stage-controls">
        <button type="button" class="phone-stage-arrow" data-dir="-1" aria-label="Previous phone">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M14.5 5.5 8 12l6.5 6.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <button type="button" class="phone-stage-arrow" data-dir="1" aria-label="Next phone">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M9.5 5.5 16 12l-6.5 6.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    ) : null
  }

  <p class="phone-stage-caption" aria-live="polite">
    {
      slides.map((s, i) => (
        <span class="phone-stage-caption-item" data-index={i} hidden={i !== start}>
          {s.caption}
        </span>
      ))
    }
  </p>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".phone-stage").forEach((stage) => {
    const count = Number(stage.dataset.count ?? "0");
    if (count < 1) return;

    const slides = Array.from(stage.querySelectorAll<HTMLElement>(".phone-slide"));
    const captions = Array.from(stage.querySelectorAll<HTMLElement>(".phone-stage-caption-item"));
    const viewport = stage.querySelector<HTMLElement>(".phone-stage-viewport");
    const stackMq = window.matchMedia("(max-width: 639px)");
    let active = Number(stage.dataset.active ?? "0");

    function stacked() {
      return stackMq.matches;
    }

    function render() {
      if (stacked()) {
        stage.removeAttribute("aria-roledescription");
        stage.removeAttribute("tabindex");
        slides.forEach((slide) => {
          slide.style.removeProperty("--offset");
          slide.removeAttribute("data-offset");
          slide.removeAttribute("aria-hidden");
        });
        captions.forEach((cap) => cap.removeAttribute("hidden"));
        return;
      }

      stage.setAttribute("aria-roledescription", "carousel");
      stage.tabIndex = 0;
      stage.dataset.active = String(active);
      slides.forEach((slide, i) => {
        // Signed offset from the centered phone: 0 center, -1/+1 neighbors.
        let offset = i - active;
        if (offset > count / 2) offset -= count;
        if (offset < -count / 2) offset += count;
        slide.style.setProperty("--offset", String(offset));
        slide.dataset.offset = String(offset);
        slide.setAttribute("aria-hidden", offset === 0 ? "false" : "true");
      });
      captions.forEach((cap, i) => cap.toggleAttribute("hidden", i !== active));
    }

    function go(dir: number) {
      if (stacked()) return;
      active = (active + dir + count) % count;
      render();
    }

    stage.querySelectorAll<HTMLElement>(".phone-stage-arrow").forEach((btn) => {
      btn.addEventListener("click", () => go(Number(btn.dataset.dir ?? "1")));
    });

    stage.addEventListener("keydown", (event) => {
      if (stacked()) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      }
    });

    // Let a tapped neighbor become the center.
    slides.forEach((slide, i) => {
      slide.addEventListener("click", () => {
        if (stacked() || i === active) return;
        active = i;
        render();
      });
    });

    if (viewport && count > 1) {
      let startX = 0;
      let startY = 0;
      let tracking = false;
      let swiping = false;

      viewport.addEventListener("pointerdown", (event) => {
        if (stacked()) return;
        tracking = true;
        swiping = false;
        startX = event.clientX;
        startY = event.clientY;
      });

      viewport.addEventListener(
        "pointermove",
        (event) => {
          if (!tracking) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (!swiping && Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) {
            swiping = true;
          }
          if (swiping) event.preventDefault();
        },
        { passive: false },
      );

      function endSwipe(event: PointerEvent) {
        if (!tracking) return;
        const dx = event.clientX - startX;
        tracking = false;
        if (swiping && Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
        swiping = false;
      }

      viewport.addEventListener("pointerup", endSwipe);
      viewport.addEventListener("pointercancel", () => {
        tracking = false;
        swiping = false;
      });
    }

    stage.dataset.reduced = reduce.matches ? "true" : "false";
    reduce.addEventListener("change", () => {
      stage.dataset.reduced = reduce.matches ? "true" : "false";
    });
    stackMq.addEventListener("change", render);

    render();
  });
</script>
