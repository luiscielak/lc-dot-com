---
import { getCollection } from "astro:content";
import portrait from "../assets/about-portrait.avif";
import BrandLockup from "../components/BrandLockup.astro";
import HomeFeaturedCard from "../components/HomeFeaturedCard.astro";
import Base from "../layouts/Base.astro";
import { resumePdfHref } from "../lib/resume";
import { isListedWork, workBadge } from "../lib/site";

const studies = (await getCollection("work"))
  .filter((study) => isListedWork(study.id, study.data.listed))
  .sort((a, b) => a.data.order - b.data.order);

/**
 * Featured proof: published cases with product imagery, in the order the
 * hero promises. Metrics are copied from confirmed frontmatter or
 * already-published listing lines — never invented.
 */
const plate = [
  {
    id: "pmi-partner-platform",
    index: "01",
    domain: "Certification",
    blurb: "Self-service platform that replaced manual B2B workflows.",
    metricValue: "$3.1M",
    metricLabel: "in revenue in the first year",
    image: "pmi-partner-platform/cover.png",
    imageAlt:
      "Partner Platform admin reports on desktop and the mobile store, showing spend and enrollment for a course",
  },
  {
    id: "field-dispatch",
    index: "02",
    domain: "Logistics",
    blurb: "Workflow platform for specialty moving ops.",
    metricValue: "47%",
    metricLabel: "faster dispatch",
    image: "field-dispatch/job-detail.png",
    imageAlt: "Phone screen of a single job: a list of crates and services, each marked packed or pending",
  },
];

const featured = plate.flatMap((item) => {
  const study = studies.find((s) => s.id === item.id);
  if (!study) return [];
  return [{ ...item, title: study.data.title, badge: workBadge(study.data) }];
});

const featuredIds = new Set(plate.map((item) => item.id));

/**
 * Result line on every listing card. Sourced from confirmed frontmatter
 * metrics or a claim already stated in that study’s MDX — never invented.
 */
const listingResults: Record<string, string> = {
  "pmi-partner-platform": "$3.1M in revenue in the first year",
  "field-dispatch": "47% faster dispatch",
  "making-compare-actually-compare": "4 advice tiers, one comparison",
  "pmi-disciplined-agile": "$2.8M in impact",
  "straatclaw": "In daily personal use",
};

/** Everything else, numbered continuously after the featured strip. */
const moreWork = studies.filter((study) => !featuredIds.has(study.id));

/** Logo row in the hero fold. `width`/`height` are the file’s intrinsic
 *  pixels (honest aspect). Optical size is `--logo-h` in CSS, not these
 *  attributes. Medium screens break after four marks (4 / 5). */
const clientRowBreaks = { mid: 4, late: 7 };

const clients = [
  { name: "Vanguard", src: "/logos/clients/vanguard.png", width: 2000, height: 421, mark: "vanguard" },
  { name: "JPMorgan Chase", src: "/logos/clients/jpmc.png", width: 2000, height: 130, mark: "jpmc" },
  { name: "PMI", src: "/logos/clients/pmi.svg", width: 105, height: 32, mark: "pmi" },
  { name: "Ford", src: "/logos/clients/ford.png", width: 1274, height: 457, mark: "ford" },
  { name: "Westat", src: "/logos/clients/westat.png", width: 1880, height: 495, mark: "westat" },
  { name: "FM", src: "/logos/clients/fm.png", width: 970, height: 485, mark: "fm" },
  { name: "Elsevier", src: "/logos/clients/elsevier.png", width: 446, height: 485, mark: "elsevier" },
  { name: "USA.gov", src: "/logos/clients/usagov.png", width: 372, height: 325, mark: "usagov" },
  { name: "Celgene", src: "/logos/clients/celgene.png", width: 570, height: 500, mark: "celgene" },
];

/**
 * Testimonials — LinkedIn recommendations. `quote` is a verbatim pull-quote
 * from each recommendation (kept short so the cards stay compact); the full
 * text lives on LinkedIn.
 *
 * Two layouts live here: "list" (stacked rows) and "cards" (bordered card
 * carousel, inspired by the Save.design testimonials section). Flip
 * `testimonialsLayout` to switch.
 */
const testimonialsLayout: "cards" | "list" = "cards";

const testimonials = [
  {
    index: "01",
    quote: "Luis is the kind of designer who makes teams better simply by being part of them.",
    name: "Michael Pacheco",
    role: "Lead UX Designer · PMI",
    linkedin: "https://www.linkedin.com/in/michael-pacheco-0242b221",
  },
  {
    index: "02",
    quote:
      "Luis brings sharp insight, expert design skill, and strategic clarity to everything he touches.",
    name: "Keriann Sabatini",
    role: "Principal Product Manager · PMI",
    linkedin: "https://www.linkedin.com/in/keriannsabatini",
  },
  {
    index: "03",
    quote:
      "Luis is incredibly talented at getting senior stakeholders on the same page through his masterful UX workshops.",
    name: "James Brown",
    role: "Sr. Experience Design Manager · FM",
    linkedin: "https://www.linkedin.com/in/james-brown-a9236b5",
  },
  {
    index: "04",
    quote:
      "A talented UX designer with an excellent ability to facilitate, shape, and collaborate in the early phases of work.",
    name: "El Cruz",
    role: "Senior Manager, Experience Design · FM",
    linkedin: "https://www.linkedin.com/in/elcruz",
  },
  {
    index: "05",
    quote:
      "Any team would be lucky to have Luis; he brings not only talent but a mindset that elevates every project he touches.",
    name: "Danielle Trombino",
    role: "Senior Product Owner · FM Global",
    linkedin: "https://www.linkedin.com/in/danielle-trombino",
  },
  {
    index: "06",
    quote:
      "His design approach helped lead the B2B platform redesign that drove $3.1M in revenue in the first year and eliminated $650K in losses.",
    name: "Patrick Olivares",
    role: "Executive Product Leader · PMI",
    linkedin: "https://www.linkedin.com/in/patrickolivares",
  },
  {
    index: "07",
    quote:
      "Luis is a talented UI/UX expert who brings clarity and innovation to every project and works well with product and engineering teams.",
    name: "Ankur Pariyani",
    role: "Co-Founder & CIO · Near-Miss Management",
    linkedin: "https://www.linkedin.com/in/ankurpariyani",
  },
  {
    index: "08",
    quote:
      "He has a way of seeing the best in people, creating a space where everyone feels heard and valued.",
    name: "Shauna Mensah",
    role: "Operations Manager · PMI",
    linkedin: "https://www.linkedin.com/in/shauna-mensah",
  },
];
---

<Base
  nameplate
  title="Luis Cielak — Clarity above all."
  description="I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next."
>
  <header class="plate-bar" slot="banner">
    <BrandLockup tone="paper" class="plate-name" />
    <p class="plate-status">
      <span>Lead Product Designer</span>
    </p>
    <nav class="plate-nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="/resume">Résumé</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <div class="nameplate">
    <div class="plate-stage">
      <canvas class="plate-field" aria-hidden="true"></canvas>

      <section class="plate-hero" aria-labelledby="plate-title">
        <p class="plate-kicker">AI &amp; Enterprise Platforms</p>
        <h1 id="plate-title">Clarity<br />above all<span class="plate-period">.</span></h1>
      </section>

      <div class="plate-intro">
        <p class="plate-bio">
          I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next. Lately that work includes AI-assisted tools and workflows, and organizing <a href="https://cursorphilly.com">Cursor Philly</a>, a community for designers and builders.
        </p>
        <div class="plate-actions">
          <a class="plate-btn" href="#work">View work <span class="plate-btn-arrow" aria-hidden="true">→</span></a>
          <a class="plate-btn plate-btn-ghost" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
          <a class="plate-btn plate-btn-ghost" href={resumePdfHref} download aria-label="Download résumé PDF">Résumé ↓</a>
        </div>
      </div>

      <section class="plate-clients plate-clients--fold" aria-labelledby="clients-label">
        <p id="clients-label">Selected clients &amp; employers</p>
        <ul class="plate-client-group">
          {
            clients.map((client, i) => (
              <>
                <li data-mark={client.mark}>
                  <img
                    src={client.src}
                    alt={client.name}
                    width={client.width}
                    height={client.height}
                    draggable="false"
                  />
                </li>
                {i + 1 === clientRowBreaks.mid ? <li class="plate-client-break" aria-hidden="true" /> : null}
                {i + 1 === clientRowBreaks.late ? (
                  <li class="plate-client-break plate-client-break-late" aria-hidden="true" />
                ) : null}
              </>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="plate-ai" aria-labelledby="ai-title">
      <h2 id="ai-title">How I use AI</h2>
      <p>
        I prototype in code with Cursor, Claude, and React, and I bring Figma into that loop with Figma MCP. I run a role-based agent team on top of Nous Research’s open-source Hermes Agent. I’m the founder and Cursor Ambassador of <a href="https://cursorphilly.com">Cursor Philly</a>.
      </p>
    </section>

    <section class="plate-featured" id="work" aria-labelledby="featured-work">
      <h2 id="featured-work">Featured work</h2>
      <ul>
        {
          featured.map((item) => (
            <HomeFeaturedCard
              href={`/work/${item.id}`}
              index={item.index}
              domain={item.domain}
              title={item.title}
              blurb={item.blurb}
              image={item.image}
              imageAlt={item.imageAlt}
              metricValue={item.metricValue}
              metricLabel={item.metricLabel}
              badge={item.badge}
            />
          ))
        }
      </ul>
    </section>

    <section class="plate-catalog" aria-labelledby="more-work">
      <h2 id="more-work">More work</h2>
      <ol>
        {
          moreWork.map((study, i) => {
            const badge = workBadge(study.data);
            const listingLabel = study.data.category ?? study.data.company;
            return (
              <li>
                <a href={`/work/${study.id}`}>
                  <span class="plate-index">
                    {String(featured.length + i + 1).padStart(2, "0")}
                    {listingLabel ? ` / ${listingLabel}` : ""}
                  </span>
                  <span class="plate-study">{study.data.title}</span>
                  <span class="plate-blurb">{study.data.subtitle}</span>
                  {listingResults[study.id] ? (
                    <span class="plate-result">{listingResults[study.id]}</span>
                  ) : null}
                  {badge ? <span class="plate-draft">{badge}</span> : null}
                </a>
              </li>
            );
          })
        }
      </ol>
    </section>

    {
      testimonialsLayout === "cards" ? (
        <section class="plate-quotes plate-quotes--cards" aria-labelledby="testimonials">
          <div class="plate-quotes-head">
            <h2 id="testimonials">Testimonials</h2>
            <div class="plate-quote-nav">
              <button type="button" class="plate-quote-arrow" data-marquee="prev" aria-label="Previous testimonial">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="plate-quote-arrow" data-marquee="next" aria-label="Next testimonial">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
          <div class="plate-quote-marquee">
            <div class="plate-quote-track">
              {[false, true].map((clone) => (
                <ul class="plate-quote-group" aria-hidden={clone ? "true" : undefined}>
                  {testimonials.map((item) => (
                    <li>
                      <blockquote>
                        <span class="pqc-mark" aria-hidden="true">”</span>
                        <p class="plate-quote-text">{item.quote}</p>
                        <footer class="pqc-foot">
                          <span class="pqc-id">
                            <span class="pqc-name">{item.name.split(" ")[0]}</span>
                            <span class="pqc-role">{item.role.split(" · ")[0]}</span>
                          </span>
                          <a
                            class="pqc-link"
                            href={item.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${item.name} on LinkedIn`}
                            tabindex={clone ? -1 : undefined}
                          >
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                              <path
                                d="M5 9.5V19M5 5.5h.01M10 19V9.5M10 13.2c0-2.1 1.6-3.7 3.7-3.7 2 0 3.3 1.2 3.3 3.6V19"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </a>
                        </footer>
                      </blockquote>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="plate-quotes" aria-labelledby="testimonials">
          <h2 id="testimonials">Testimonials</h2>
          <ul>
            {testimonials.map((item) => (
              <li>
                <blockquote>
                  <span class="plate-quote-meta">
                    <span class="plate-index">{item.index}</span>
                  </span>
                  <p class="plate-quote-text">{item.quote}</p>
                  <footer>
                    <cite class="plate-quote-cite">
                      {item.name} · {item.role}
                    </cite>
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="about" id="about" aria-labelledby="about-title">
      <div class="about-intro">
        <div class="about-copy">
          <h2 id="about-title">
            I help product teams<br />
            bring clarity to tools<br />
            people rely on<br />
            under pressure.
          </h2>
          <p class="about-closer">
            Rooted in research. Guided by systems. Delivered with care.<br />
            I run <a href="https://thehoomanloop.com">The Hooman Loop</a>.
          </p>
        </div>
        <img
          class="about-portrait"
          src={portrait.src}
          width={portrait.width}
          height={portrait.height}
          alt="Portrait of Luis Cielak"
        />
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountSignalField } from "../scripts/signal-field";
  import { mountTestimonialMarquee } from "../scripts/testimonial-marquee";

  mountSignalField();
  mountTestimonialMarquee();
</script>
