---
import type { CollectionEntry } from "astro:content";
import AgentTeamMap from "./AgentTeamMap.astro";
import Figure from "./Figure.astro";
import PhoneStage from "./PhoneStage.astro";
import { workBadge } from "../lib/site";
import { renderProse } from "../lib/prose";

interface Props {
  entry: CollectionEntry<"work">;
  next?: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const d = entry.data;
const v = d.visuals;
const gallery = d.gallery ?? {};
const approvalFigures = [v.decisions, ...(gallery.decisions ?? [])].filter(
  (item): item is NonNullable<typeof v.decisions> => Boolean(item),
);
const badge = workBadge(d);
const nextBadge = next ? workBadge(next.data) : undefined;

function html(s?: string) {
  return s ? renderProse(s) : "";
}
---

<article class="product-study">
  <header class="ps-hero wrap">
    <p class="ps-kicker">
      {badge ? <span class="badge">{badge}</span> : null}
      Case study
    </p>
    <h1>{d.title}</h1>
    <p class="ps-sub">{d.subtitle}</p>
    {d.tldr ? <div class="prose ps-lede" set:html={html(d.tldr)} /> : null}
    {
      d.role || d.platforms || d.tools || d.status || d.company || d.years ? (
        <dl class="meta-row ps-meta">
          {d.company ? (
            <div>
              <dt>Company</dt>
              <dd>{d.company}</dd>
            </div>
          ) : null}
          {d.role ? (
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
          ) : null}
          {d.years ? (
            <div>
              <dt>Timeline</dt>
              <dd>{d.years}</dd>
            </div>
          ) : null}
          {d.platforms ? (
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms}</dd>
            </div>
          ) : null}
          {d.tools ? (
            <div>
              <dt>Tools</dt>
              <dd>{d.tools}</dd>
            </div>
          ) : null}
          {d.status ? (
            <div>
              <dt>Status</dt>
              <dd>{d.status}</dd>
            </div>
          ) : null}
        </dl>
      ) : null
    }
    {d.overview ? <div class="prose ps-overview" set:html={html(d.overview)} /> : null}
  </header>

  {
    d.challenges.length ? (
      <section class="ps-principles wrap" aria-label="Design principles">
        <ul>
          {d.challenges.map((c) => (
            <li>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  {
    d.phones?.length ? (
      <section class="ps-band ps-phones wrap" aria-labelledby="ps-phones-title">
        <div class="ps-band-head">
          <h2 id="ps-phones-title">Where it reaches me</h2>
          <p>
            Telegram for quick captures, status, and the morning brief. Slack for real work, one
            thread per task.
          </p>
        </div>
        <PhoneStage phones={d.phones} label="StraatClaw on the phone" />
      </section>
    ) : null
  }

  {
    d.solution ? (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>How it works</h2>
        </div>
        <div class="prose" set:html={html(d.solution)} />
        {v.solution ? (
          <div class="ps-panel">
            <Figure {...v.solution} />
          </div>
        ) : d.teamMap ? (
          <AgentTeamMap caption={d.teamMap.caption} />
        ) : null}
        {(gallery.solution ?? []).map((item) => (
          <div class="ps-panel">
            <Figure {...item} />
          </div>
        ))}
      </section>
    ) : null
  }

  {
    d.research ? (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>{d.researchHeading}</h2>
        </div>
        <div class="prose" set:html={html(d.research)} />
      </section>
    ) : null
  }

  {
    d.decisions ? (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>Design decisions</h2>
        </div>
        <div class="prose" set:html={html(d.decisions)} />
        {v.overview ? (
          <div class="ps-panel">
            <Figure {...v.overview} />
          </div>
        ) : null}
      </section>
    ) : null
  }

  {
    approvalFigures.length ? (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>The approval moment</h2>
        </div>
        <div class:list={["ps-approvals", approvalFigures.length > 1 && "is-pair"]}>
          {approvalFigures.map((item) => (
            <div class="ps-panel">
              <Figure {...item} />
            </div>
          ))}
        </div>
      </section>
    ) : null
  }

  {
    d.outcome || d.dailyPhones?.length ? (
      <section class="ps-band wrap">
        <div class="ps-band-head">
          <h2>In daily use</h2>
        </div>
        {d.outcome ? <div class="prose" set:html={html(d.outcome)} /> : null}
        {d.dailyPhones?.length ? (
          <PhoneStage phones={d.dailyPhones} label="Cursor Philly jobs on the phone" />
        ) : null}
      </section>
    ) : null
  }

  {
    d.reflection ? (
      <section class="ps-close wrap">
        <div class="prose" set:html={html(d.reflection)} />
      </section>
    ) : null
  }

  {
    next ? (
      <nav class="next wrap">
        <span>Next case study</span>
        <a href={`/work/${next.id}`}>
          {nextBadge ? `${nextBadge} · ` : ""}
          {next.data.title}
        </a>
      </nav>
    ) : null
  }
</article>
