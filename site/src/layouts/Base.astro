---
import "@hooman-loop/konstrukt/css";
import "@hooman-loop/konstrukt/base.css";
import "../styles/site.css";
import BrandLockup from "../components/BrandLockup.astro";

interface Props {
  title: string;
  description?: string;
  /** Inverted nameplate landing. Replaces the light site chrome. */
  nameplate?: boolean;
  /** Résumé artboard. Page supplies its own header and footer. */
  resume?: boolean;
}

const {
  title,
  description = "Lead Product Designer / design engineer. Portfolio of Luis Cielak.",
  nameplate = false,
  resume = false,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-mode="light"
  data-page={nameplate ? "nameplate" : resume ? "resume" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0A0A" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&family=Space+Grotesk:wght@500;600&display=swap"
    />
  </head>
  <body id="top">
    <a class="skip" href="#content">Skip to content</a>
    {
      nameplate || resume ? (
        <slot name="banner" />
      ) : (
        <header class="site-header">
          <div class="wrap nav">
            <BrandLockup class="nav-home" />
            <nav class="nav-links" aria-label="Primary">
              <a href="/#work">Work</a>
              <a href="/#about">About</a>
              <a href="/resume">Résumé</a>
              <a href="/#contact">Contact</a>
            </nav>
          </div>
        </header>
      )
    }
    <main id="content">
      <slot />
    </main>
    {
      !resume && (
        <footer class="site-footer">
          <div class="foot-links">
            <nav class="foot-col" aria-labelledby="foot-index">
              <p class="foot-label" id="foot-index">Index</p>
              <ul class="foot-items">
                <li><a href="/">Home</a></li>
                <li><a href="/#work">Work</a></li>
                <li><a href="/#about">About</a></li>
                <li><a href="/resume">Résumé</a></li>
              </ul>
            </nav>
            <nav class="foot-col" aria-labelledby="foot-contact">
              <p class="foot-label" id="foot-contact">Contact</p>
              <ul class="foot-items">
                <li><a href="https://www.linkedin.com/in/cielak">LinkedIn</a></li>
                <li><a href="https://github.com/luiscielak">GitHub</a></li>
                <li>
                  <a class="foot-email" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
                </li>
              </ul>
            </nav>
          </div>
          <div class="foot-name">
            <a class="foot-mark" href="/" aria-label="Luis Cielak">
              <svg viewBox="6 -2 20 28" aria-hidden="true" focusable="false">
                <path
                  d="M6 -2L10 -2L10 22L24 22L24 26L9 26A3 3 0 0 1 6 23ZM26 4L26 8L18 8L18 14L24 14L24 18L17 18A3 3 0 0 1 14 15L14 7A3 3 0 0 1 17 4Z"
                  fill="currentColor"
                />
              </svg>
            </a>
            <p class="foot-baseline">
              <a class="foot-top" href="#top">Back to top</a>
              <span class="foot-meta">© 2026 · Philadelphia · CDMX</span>
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>
