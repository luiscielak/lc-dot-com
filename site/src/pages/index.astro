---
import { getCollection } from "astro:content";
import portrait from "../assets/portrait.jpg";
import BrandLockup from "../components/BrandLockup.astro";
import Base from "../layouts/Base.astro";

const studies = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

/** Poster copy from Paper, Landing 3 — Bold (Inverted Nameplate). */
const plate = [
  {
    id: "field-dispatch",
    index: "01",
    domain: "Logistics",
    title: "MSS Specialty Services",
    blurb: "Workflow platform for specialty moving ops.",
  },
  {
    id: "pmi-disciplined-agile",
    index: "02",
    domain: "Certification",
    title: "PMI Disciplined Agile",
    blurb: "Mobile-first PWA for agile coaches.",
  },
  {
    id: "straatclaw",
    index: "03",
    domain: "AI field tool",
    title: "StraatClaw",
    blurb: "Agent-assisted tool for field operators.",
  },
];

const featured = plate.flatMap((item) => {
  const study = studies.find((s) => s.id === item.id);
  if (!study) return [];
  return [{ ...item, draft: study.data.draft }];
});

const moreCount = studies.length - featured.length;

/** Practice lines from the About section. */
const practice = [
  {
    title: "User Experience",
    body: "The path through a complicated product, so the next step is obvious when it matters.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="7" cy="8" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="23" cy="15" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="23" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 9.4c4.2.4 7 3.2 7 5.6h4.6M16 15c0 3.4-2.6 6.2-5.2 6.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
  {
    title: "User Research",
    body: "Time with the people doing the job, used to change the plan — not to decorate it.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 22.5v-1.2c0-2.6 2.9-4.6 6.5-4.6s6.5 2 6.5 4.6v1.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
  {
    title: "Interface Design",
    body: "Structure, rhythm, and a system so a dense product stays calm as it grows.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><rect x="5" y="6" width="9" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="16" y="6" width="9" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="5" y="16" width="20" height="8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
  },
  {
    title: "Data Visualization",
    body: "The few signals someone needs in order to decide, not every number the system can show.",
    icon: `<svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path d="M6 23V17M12 23V11M18 23V14M24 23V8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  },
];
---

<Base
  nameplate
  title="Luis Cielak — Clarity above all."
  description="I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next."
>
  <header class="plate-bar" slot="banner">
    <BrandLockup tone="paper" class="plate-name" />
    <p class="plate-status">
      <span>Lead Product Designer</span>
    </p>
    <nav class="plate-nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="/resume">Résumé</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <div class="nameplate">
    <div class="plate-stage">
      <canvas class="plate-field" aria-hidden="true"></canvas>

      <section class="plate-hero" aria-labelledby="plate-title">
        <p class="plate-kicker">AI &amp; Enterprise Platforms</p>
        <h1 id="plate-title">Clarity<br />above all<span class="plate-period">.</span></h1>
      </section>

      <div class="plate-intro">
        {/* TODO(Luis): link "Cursor Philly" once the community URL is confirmed. */}
        <p class="plate-bio">
          I’m Luis Cielak, a lead product designer in Philadelphia. For fifteen years I’ve designed high-stakes products — risk, finance, certification, logistics — so people can see what a system is doing and decide what to do next. Lately that work includes AI-assisted tools and workflows, and organizing Cursor Philly, a community for designers and builders.
        </p>
        <div class="plate-actions">
          <a class="plate-btn" href="#work">View work <span class="plate-btn-arrow" aria-hidden="true">→</span></a>
          <a class="plate-btn plate-btn-ghost" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
        </div>
      </div>
    </div>

    <ul class="plate-strip">
      {
        featured.map((item) => (
          <li>
            <a href={`/work/${item.id}`}>
              <span class="plate-kicker-row">
                <span class="plate-index">
                  {item.index} / {item.domain}
                </span>
                {item.draft ? <span class="plate-draft">Draft</span> : null}
              </span>
              <span class="plate-study">{item.title}</span>
              <span class="plate-blurb">{item.blurb}</span>
              <svg
                class="plate-card-arrow"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.25" />
              </svg>
            </a>
          </li>
        ))
      }
      <li>
        <a class="plate-more" href="#work">
          <span class="plate-more-count">+ {moreCount} more</span>
          <span class="plate-all">Recent work <span class="plate-all-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    </ul>

    <section class="plate-catalog" id="work" aria-labelledby="recent-work">
      <h2 id="recent-work">Recent work</h2>
      <ol>
        {
          studies.map((study, i) => (
            <li>
              <a href={`/work/${study.id}`}>
                <span class="plate-index">
                  {String(i + 1).padStart(2, "0")}
                  {study.data.company ? ` / ${study.data.company}` : ""}
                </span>
                <span class="plate-study">{study.data.title}</span>
                <span class="plate-blurb">{study.data.subtitle}</span>
                {study.data.draft ? <span class="plate-draft">Draft</span> : null}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about" id="about" aria-labelledby="about-title">
      <div class="about-intro">
        <div class="about-copy">
          <p class="about-kicker">
            <span class="about-dot" aria-hidden="true"></span>
            Product design for complex systems
          </p>
          <h2 id="about-title">
            I help product teams<br />
            bring clarity to tools<br />
            people rely on<br />
            under pressure.
          </h2>
          <p class="about-closer">
            Rooted in research. Guided by systems. Delivered with care.
          </p>
          <p class="about-fact">Philadelphia, originally from Mexico City.</p>
        </div>
        <img
          class="about-portrait"
          src={portrait.src}
          width={portrait.width}
          height={portrait.height}
          alt="Portrait of Luis Cielak"
        />
      </div>

      <div class="about-practice" aria-label="Practice">
        {
          practice.map((item) => (
            <article>
              <h3>
                <span class="about-icon" set:html={item.icon} />
                {item.title}
              </h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="plate-contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <div class="about-contact">
        <div class="about-socials">
          <a href="https://www.linkedin.com/in/cielak" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 9.5V19M5 5.5h.01M10 19V9.5M10 13.2c0-2.1 1.6-3.7 3.7-3.7 2 0 3.3 1.2 3.3 3.6V19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="https://github.com/luiscielak" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.66-.18 1.36-.27 2.06-.27.7 0 1.4.09 2.06.27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" fill="currentColor"></path>
            </svg>
          </a>
          <a href="mailto:luis@luiscielak.com" aria-label="Email">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
              <path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <a class="about-email" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountSignalField } from "../scripts/signal-field";

  mountSignalField();
</script>
