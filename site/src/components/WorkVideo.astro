---
import { Picture } from "astro:assets";
import { workImage } from "../lib/images";

interface Props {
  src: string;
  poster: string;
  caption: string;
  fallbackAlt: string;
  maxCssPx: number;
  /** Phone-width frame. Desktop recordings leave this off. */
  phone?: boolean;
  /** Public URL of a grayscale mask that knocks the device onto `--bg`. */
  mask?: string;
  /** Optional VP9-alpha WebM served before the MP4. */
  webm?: string;
}

const { src, poster, caption, fallbackAlt, maxCssPx, phone = true, mask, webm } = Astro.props;
const posterImage = workImage(poster);
const cap = Math.min(maxCssPx, Math.floor(posterImage.width / 1.5));
const vars = [
  phone ? `--phone-max: ${cap}px` : `--figure-max: ${cap}px`,
  mask ? `--device-mask: url("${mask}")` : "",
]
  .filter(Boolean)
  .join("; ");
---

<figure
  class:list={["figure", phone && "phone", mask && "is-knockout"]}
  style={vars}
  data-src={poster}
  data-src-width={posterImage.width}
  data-render-max={cap}
>
  <video
    class="js-loop-video"
    autoplay
    muted
    loop
    playsinline
    poster={posterImage.src}
    aria-label={caption}
  >
    {webm ? <source src={webm} type="video/webm" /> : null}
    <source src={src} type="video/mp4" />
  </video>
  <div class="js-video-fallback" hidden>
    <Picture
      src={posterImage}
      alt={fallbackAlt}
      formats={["avif", "webp"]}
      widths={[640, 960].filter((w) => w <= posterImage.width)}
      sizes={`min(100vw - 2rem, ${cap}px)`}
      quality={90}
    />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  function apply() {
    document.querySelectorAll(".js-loop-video").forEach((node) => {
      const video = node as HTMLVideoElement;
      const fallback = video.parentElement?.querySelector(".js-video-fallback") as HTMLElement | null;
      if (reduce.matches) {
        video.pause();
        video.setAttribute("hidden", "");
        fallback?.removeAttribute("hidden");
      } else {
        video.removeAttribute("hidden");
        fallback?.setAttribute("hidden", "");
        void video.play().catch(() => {
          video.setAttribute("hidden", "");
          fallback?.removeAttribute("hidden");
        });
      }
    });
  }
  apply();
  reduce.addEventListener("change", apply);
</script>
