---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import BrandLockup from "../components/BrandLockup.astro";
import Base from "../layouts/Base.astro";

/** TODO(Luis): add the current résumé PDF at public/resume.pdf. The old Dropbox link stays retired. */
const resumePdfPath = fileURLToPath(new URL("../../public/resume.pdf", import.meta.url));
const hasResumePdf = existsSync(resumePdfPath);

/** Copy and hierarchy from the Paper résumé artboard. */
const impact = [
  "Complex decision-support interfaces. Designed FM Portal dashboards at FM Global that surface claims, supply-chain risk, and location data from multiple systems into a single decision view.",
  "Reusable patterns at platform scale. Owned and evolved design systems across FM Global and PMI; raised development velocity 20% at PromptWorks.",
  "Designing for trust, review, and failure. Shipped high-stakes workflows at Vanguard and PMI where state must be unambiguous before a person acts.",
  "Translating user goals into system requirements. Partnered with research and domain experts at Elsevier and PMI to turn workflows into product requirements, not just screens.",
  "Technical fluency in the medium. Front-end build (HTML/CSS/JS, React), browser-based design-to-code prototyping, and an AI-assisted practice taught through Cursor Philly.",
];

const roles = [
  {
    dates: ["2025 — Present", "Contract"],
    title: "Lead UX Product Designer",
    place: "Malvern, PA",
    org: "Vanguard",
    scale: "lead",
    rule: "ink",
    summary:
      "Own end-to-end UX for Vanguard’s digital investor experience, from discovery through shipped, reusable design decisions. Defined IA, flows, and high-fidelity designs for investor education and account journeys; delivered annotated specs and design-system-aligned components; led critique and alignment that cut late-stage rework.",
  },
  {
    dates: ["2023 — 2025", "Contract"],
    title: "Lead UX Designer",
    place: "Johnston, RI",
    org: "FM Global",
    scale: "lead",
    summary:
      "Owned design for FM Portal, a browser-based self-service platform for commercial property risk serving thousands of risk managers globally. Designed complex dashboards for claims, supply-chain risk, and location transparency; drove data-visualization patterns that made risk legible to non-expert users; evolved the design system across product areas.",
  },
  {
    dates: ["2021 — 2025"],
    title: "Digital Experience Design Lead",
    place: "Philadelphia, PA",
    org: "Project Management Institute (PMI)",
    scale: "lead",
    // TODO(Luis): Confirm $3.75M first-year revenue (vs $3.1M + $650K wording). Do not render until sourced.
    summary:
      "Led UX for a program-level modernization of PMI’s B2B platform, replacing manual and legacy workflows with self-service web experiences. Owned the Partner Platform zero-to-one (coupon distribution, certification management) and legacy modernization; translated complex requirements into scalable IA and prototypes, increasing conversions 30%. Owned research and mentored designers.",
  },
  {
    dates: ["2013 — Present"],
    // TODO(Luis): Confirm whether Near-Miss Management is still ongoing ("2013 — Present").
    datesFaint: true,
    title: "Design Consultant",
    place: "Remote",
    org: "Near-Miss Management",
    scale: "lead",
    summary:
      "Design the company’s flagship product: an interactive decision-support system that visualizes process risk and alarm data in oil refineries, increasing information transparency for a more comprehensive operator experience. Partner with stakeholders to continuously reassess needs and improve functionality.",
  },
  {
    dates: ["2020 — 2021"],
    title: "Senior User Experience Designer",
    place: "Philadelphia, PA",
    org: "Elsevier",
    summary:
      "Modernized clinical-trial and oncology software; new UI and data-visualization patterns raised user satisfaction 30%.",
  },
  {
    dates: ["2019 — 2020"],
    title: "Senior User Experience Designer",
    place: "Philadelphia, PA",
    org: "Vanguard",
    summary:
      "Designed web-based financial planning and retirement tools for thousands of internal advisors; simplified complex investment workflows.",
  },
  {
    dates: ["2017 — 2019"],
    title: "UX Designer & UI Engineer",
    place: "Philadelphia, PA",
    org: "PromptWorks",
    summary:
      "Owned experience strategy and front-end build (HTML/CSS/JS); improved design-to-dev handoff, raising development velocity 20%; mentored junior designers.",
  },
  {
    dates: ["2016 — 2017"],
    title: "Adjunct Professor",
    place: "Philadelphia, PA",
    org: "Thomas Jefferson University",
    summary:
      "Taught graduate Interactive Design and UX Thesis courses; mentored 20+ students through end-to-end design process.",
  },
  {
    dates: ["2014 — 2017"],
    title: "Design Consultant",
    place: "Philadelphia, PA",
    org: "Mega Supply Pro",
    summary:
      "Analytics-driven design across e-commerce platforms (Shopify, Amazon, eBay), driving $1.72M in new revenue.",
  },
  {
    dates: ["2013"],
    title: "Design Consultant",
    place: "Philadelphia, PA",
    org: "Electronic Ink",
    summary:
      "Designed an operational-modeling visualization for pharmaceutical regulatory reporting across the product line.",
  },
  {
    dates: ["2008 — 2013"],
    title: "Business Management Analyst / Associate",
    place: "Newark, DE",
    org: "JP Morgan Chase",
    last: true,
    summary:
      "Built financial dashboards and web-based reporting that streamlined executive reporting and reduced print usage 80%.",
  },
];
---

<Base
  resume
  title="Résumé — Luis Cielak"
  description="Lead Product Designer for AI and enterprise platforms. Fifteen years across financial services, risk, and data-dense research."
>
  <header class="cv-band" slot="banner">
    <div class="cv-sheet cv-bar">
      <BrandLockup class="cv-name" />
      <nav class="cv-nav" aria-label="Primary">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/resume" aria-current="page">Résumé</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="cv-band cv-band-ink">
    <header class="cv-sheet cv-hero">
      <div class="cv-kicker-row">
        <p class="cv-kicker">Résumé — 15+ years</p>
        {
          hasResumePdf ? (
            <a class="cv-download" href="/resume.pdf">Download PDF ↓</a>
          ) : null
        }
      </div>
      <h1>
        <span class="cv-title">Lead Product Designer</span>
        <span class="cv-title-faint">AI & Enterprise Platforms</span>
      </h1>
      <p class="cv-lede">
        I design complex, high-stakes enterprise and platform products across financial services, risk, and data-dense research. The through-line: making system behavior legible enough to act on — designing the surface around intelligence and multi-source data so people can see what the system is doing, how confident it is, and what to do next. I work in Figma and in code, own design systems and handoff, and run an AI-assisted design practice.
      </p>
      <ul class="cv-contact">
        <li>Philadelphia Metro Area</li>
        <li><a href="mailto:luis@luiscielak.com">luis@luiscielak.com</a></li>
        <li><a href="https://www.linkedin.com/in/cielak">linkedin.com/in/cielak</a></li>
        <li><a href="https://luiscielak.com">luiscielak.com</a></li>
      </ul>
    </header>
  </div>

  <div class="cv-band">
    <section class="cv-sheet cv-impact" aria-labelledby="impact-title">
      <h2 id="impact-title">Selected impact</h2>
      <ol>
        {
          impact.map((item, i) => (
            <li>
              <span>{String(i + 1).padStart(2, "0")}</span>
              <p>{item}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <section class="cv-sheet cv-work" aria-labelledby="experience-title">
    <h2 id="experience-title">Professional experience</h2>
    <ol>
      {
        roles.map((role) => (
          <li
            class:list={[
              role.scale === "lead" && "is-lead",
              role.rule === "ink" && "is-ink",
              role.last && "is-last",
            ]}
          >
            <p class:list={["cv-when", role.datesFaint && "is-faint"]}>
              {role.dates.map((line) => (
                <span>{line}</span>
              ))}
            </p>
            <div class="cv-role">
              <div class="cv-role-head">
                <h3>{role.title}</h3>
                <p>{role.place}</p>
              </div>
              <p class="cv-org">{role.org}</p>
              <p class="cv-summary">{role.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="cv-sheet cv-facts" aria-label="Skills, education, and community">
    <div>
      <h2>Core competencies</h2>
      <p>
        AI product design (human-in-the-loop) · AI/ML experience design · design systems & component libraries · design-to-code prototyping · information architecture · complex transactional workflows · data visualization & decision support · B2B, enterprise & fintech · qual & quant research · usability, accessibility & heuristic review · cross-functional facilitation · legacy modernization.
      </p>
      <h2>Languages</h2>
      <p>Spanish — fluent. English — fluent.</p>
    </div>
    <div class="cv-tools">
      <h2 class="is-accent">AI & agentic workflows</h2>
      <p>Cursor AI · Claude · v0 · Figma Make · Figma MCP · Lovable / Bolt</p>
      <h2>Design & prototyping</h2>
      <p>Figma · Sketch · Adobe CS · InVision</p>
      <h2>Web & front-end</h2>
      <p>HTML · CSS/Sass · JavaScript · React · Tailwind · Git</p>
      <h2>Analytics & methods</h2>
      <p>Power BI · Tableau · D3.js · Python · OOUX · Lean UX · Agile</p>
    </div>
    <div class="cv-edu">
      <h2>Education</h2>
      <p class="cv-degree">MS, Interactive Design & Media</p>
      <p class="cv-school">Thomas Jefferson University · 2014</p>
      <p class="cv-degree">BS, Management Information Systems</p>
      <p class="cv-school">Florida State University · 2008</p>
      <h2>Certifications</h2>
      <p class="cv-certs">
        Certified OOUX Strategist — Rewired UX Studio, 2024<br />
        UX Certificate — Nielsen Norman Group, 2024
      </p>
      <h2 class="is-accent">Community</h2>
      <p class="cv-degree">Cursor AI Ambassador — Cursor Philly</p>
      <p class="cv-community">
        Lead a 1,000+ Philadelphia community (~110 monthly) focused on AI-assisted development; organize monthly meetups and hands-on workshops.
      </p>
    </div>
  </section>

  <footer class="cv-band cv-band-top">
    <div class="cv-sheet cv-foot">
      <p>Luis Cielak — Résumé — 2026</p>
      <a href="mailto:luis@luiscielak.com">luis@luiscielak.com →</a>
    </div>
  </footer>
</Base>
