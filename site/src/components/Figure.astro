---
import { Picture } from "astro:assets";
import { workImage } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  maxCssPx: number;
  phone?: boolean;
}

const { src, alt, caption, maxCssPx, phone } = Astro.props;
const image = workImage(src);
const cap = Math.min(maxCssPx, Math.floor(image.width / 1.5));
const widths = [
  ...new Set(
    [640, 960, 1280, 1600, 1920, 2560, image.width].filter((w) => w <= image.width),
  ),
].sort((a, b) => a - b);
---

<figure
  class:list={["figure", phone && "phone"]}
  style={`--figure-max: ${cap}px; --phone-max: ${cap}px`}
  data-src={src}
  data-src-width={image.width}
  data-render-max={cap}
>
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths.length ? widths : [image.width]}
    sizes={`min(100vw - 2rem, ${cap}px)`}
  />
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
