---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import ProductStudy from "../../components/ProductStudy.astro";
import EditorialStudy from "../../components/EditorialStudy.astro";

export async function getStaticPaths() {
  const studies = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return studies.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: studies[(i + 1) % studies.length] },
  }));
}

const { entry, next } = Astro.props;
const presentation = entry.data.presentation;
---

<Base title={`${entry.data.title} — Luis Cielak`} description={entry.data.subtitle}>
  {
    presentation === "editorial" ? (
      <EditorialStudy entry={entry} next={next} />
    ) : presentation === "product" ? (
      <ProductStudy entry={entry} next={next} />
    ) : (
      <CaseStudy entry={entry} next={next} />
    )
  }
</Base>
